{
    "name":  "@commitpress/sdk",
    "version":  "0.1.0",
    "description":  "Type-safe query SDK for commitpress content",
    "type":  "module",
    "main":  "./dist/index.cjs",
    "module":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "bin":  {
                "commitpress":  "./dist/cli.js"
            },
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "require":  "./dist/index.cjs"
                          },
                    "./server":  {
                                     "types":  "./dist/server.d.ts",
                                     "import":  "./dist/server.js",
                                     "require":  "./dist/server.cjs"
                                 },
                    "./preview":  {
                                      "types":  "./dist/preview.d.ts",
                                      "import":  "./dist/preview.js",
                                      "require":  "./dist/preview.cjs"
                                  },
                    "./image":  {
                                    "types":  "./dist/image.d.ts",
                                    "import":  "./dist/image.js",
                                    "require":  "./dist/image.cjs"
                                },
                    "./blocks":  {
                                     "types":  "./dist/blocks.d.ts",
                                     "import":  "./dist/blocks.js",
                                     "require":  "./dist/blocks.cjs"
                                 },
                    "./gallery":  {
                                      "types":  "./dist/gallery.d.ts",
                                      "import":  "./dist/gallery.js",
                                      "require":  "./dist/gallery.cjs"
                                  },
                    "./richtext":  {
                                       "require":  "./dist/richtext.cjs",
                                       "types":  "./dist/richtext.d.ts",
                                       "import":  "./dist/richtext.js"
                                   }
                },
    "scripts":  {
                    "build":  "tsup",
                    "dev":  "tsup --watch",
                    "prepare":  "tsup"
                },
    "devDependencies":  {
                            "@types/node":  "^25.8.0",
                            "tsup":  "^8.0.0",
                            "typescript":  "^5.0.0"
                        }
}
