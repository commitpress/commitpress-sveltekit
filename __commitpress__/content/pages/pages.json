          "heading": "What can you change?",
          "items": [
            {
              "question": "Can I rearrange the sections?",
              "answer": "Yes. These sections are separate blocks in the page content. Reorder them in Commitpress to change the page."
            },
            {
              "question": "Are navigation and footer editable too?",
              "answer": "Yes. They come from the site global, shared by every page and translated for each language."
            },
            {
              "question": "Can I preview an unpublished entry?",
              "answer": "Yes. The collection includes an example draft. The public site hides it, while the preview route can display it."
