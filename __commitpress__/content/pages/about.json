  "content": {
    "page": {
      "eyebrow": "About the starter",
      "title": "A starting point, with space to grow.",
      "summary": "This example shows how a few reusable sections can become a complete page. Everything here is ready to be replaced with your own content.",
      "next_page": {
        "href": "/",
        "label": "Back to home",
        "type": "internal"
      },
      "caption": "From the image library",
      "body_label": "Page content"
    },
    "blocks": [
      {
        "faq": {
          "eyebrow": "Good to know",
          "heading": "A few simple answers.",
          "items": [
            {
              "question": "Can I change the look?",
              "answer": "Yes. Colors, typography, and the page width are defined together in the theme. Adjust them once to give the whole site your own visual identity."
            },
            {
              "question": "Where does the content live?",
              "answer": "The example pages and site settings live in the repository, under __commitpress__/content. You can edit them directly or connect the repository to Commitpress."
            },
            {
              "question": "Can I add my own sections?",
              "answer": "Yes. Add a section to the page schema and its component to the block renderer. Start small and add what your site needs."
            }
          ]
        }
      },
      {
        "cta": {
          "eyebrow": "Your next chapter",
          "heading": "Start with something simple.",
          "body": "You don't need a big site to make a good first impression. A clear message and a few thoughtful details go a long way.",
